# Copy to .env and fill in. Never commit .env.

# Apify token for the competitor scraper: console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Logged-in RedNote (xiaohongshu.com) cookie string for the agency scraper.
# DevTools -> Application -> Cookies; must include web_session (HttpOnly).
XHS_COOKIES=

# Optional: analyze_and_send.py (Claude analysis + Telegram digest)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
